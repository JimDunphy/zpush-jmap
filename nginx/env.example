#################################
# Z-Push + Stalwart Backend env #
#################################

# Container image tag
ZPUSH_IMAGE=local/zpush:latest

# Network for image build steps. Set host when Docker bridge networking is
# unavailable (for example, hosts with Docker firewall management disabled).
# Runtime containers always use host networking, independently of this setting.
ZPUSH_BUILD_NETWORK=default

# Host interface and port for the backend listener.
# Lab testing can use 0.0.0.0; production should use 127.0.0.1 or a specific service IP.
ZPUSH_BIND_ADDRESS=127.0.0.1
ZPUSH_HTTP_PORT=10000

# Optional public HTTPS hostname advertised by Autodiscover, with an optional
# port (for example sync.example.com:8443). Do not include a scheme or path.
# Leave empty to use the incoming HTTP Host. Startup rejects invalid values.
ZPUSH_HOST=

# PHP / Upload sizing and timeouts (tune as needed)
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=50M
PHP_POST_MAX_SIZE=50M
PHP_MAX_EXECUTION_TIME=3600
PHP_MAX_INPUT_TIME=3600

# NGINX client body size (must be >= PHP post size)
NGINX_CLIENT_MAX_BODY_SIZE=50m

# Stalwart Backend Configuration
# The Stalwart server URL (JMAP endpoint usually)
STALWART_URL=http://localhost:10080

# Backend release identifier shown in logs and runtime diagnostics
STALWART_BACKEND_VERSION=dev

# TLS verification (keep true in production)
STALWART_SSL_VERIFYPEER=true
STALWART_SSL_VERIFYHOST=true

# Allow insecure HTTP to non-loopback Stalwart URLs (keep false in production)
STALWART_ALLOW_INSECURE_HTTP=false

# Rust JMAP transport timeouts in seconds
STALWART_CONNECT_TIMEOUT_SECS=10
STALWART_REQUEST_TIMEOUT_SECS=60
STALWART_BLOB_TIMEOUT_SECS=180

# JMAP Push-assisted ChangeSink controls
STALWART_PUSH_CHANGES_ENABLED=true
STALWART_PUSH_EVENT_TYPES=Mailbox,Email,ContactCard,CalendarEvent
STALWART_PUSH_CLOSEAFTER=state
STALWART_PUSH_PING_SECS=30

# Device ABQ policy (Allow / Block / Quarantine)
STALWART_ABQ_ENABLED=false
# Comma-separated rules. Prefix with ua:, dt:, id:, or any: (default any:).
# Use re: for regex patterns (example: ua:re:^Outlook/.*$).
STALWART_ABQ_ALLOWED_RULES=
STALWART_ABQ_BLOCKED_RULES=
STALWART_ABQ_QUARANTINED_RULES=
STALWART_ABQ_QUARANTINE_BY_DEFAULT=false

# Starter hardened profile (recommended rollout)
# Phase 1: audit mode (collect device fingerprints without blocking)
# STALWART_ABQ_ENABLED=true
# STALWART_ABQ_ALLOWED_RULES=
# STALWART_ABQ_BLOCKED_RULES=
# STALWART_ABQ_QUARANTINED_RULES=
# STALWART_ABQ_QUARANTINE_BY_DEFAULT=false
#
# Phase 2: enforce known fleet (example, adjust to your environment)
# STALWART_ABQ_ALLOWED_RULES=dt:iphone,dt:ipad,ua:*outlook*
# STALWART_ABQ_BLOCKED_RULES=ua:*legacy-eas-client*,ua:*unknown-eas*
# Optional SSH target for --deploy and --remote-version (configure locally).
ZPUSH_DEPLOY_SSH=
ZPUSH_DEPLOY_DIR=
